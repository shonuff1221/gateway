{
  "name": "gateway",
  "type": "docker",
  "port": 15888,
  "env": {
    "GATEWAY_PASSPHRASE": {
      "type": "secret",
      "description": "Gateway passphrase for encryption"
    },
    "COOLIFY": {
      "value": "true",
      "description": "Enable Coolify mode (uses HTTP instead of HTTPS)"
    },
    "DEV": {
      "value": "false",
      "description": "Development mode"
    }
  },
  "volumes": [
    {
      "host": "/home/gateway/conf",
      "container": "/home/gateway/conf"
    },
    {
      "host": "/home/gateway/logs",
      "container": "/home/gateway/logs"
    },
    {
      "host": "/home/gateway/db",
      "container": "/home/gateway/db"
    }
  ],
  "healthCheck": {
    "path": "/",
    "port": 15888
  }
}
